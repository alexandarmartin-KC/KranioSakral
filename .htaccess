RewriteEngine On

# PHP-first site
DirectoryIndex forside.php

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect legacy homepage URLs to canonical root
RewriteRule ^(index(\.php|\.html)?|forside(\.php|\.html)?)$ / [L,R=301,NC]

# Redirect legacy HTML/PHP URLs to clean URLs
RewriteRule ^(kranio-sakral-terapi|priser-booking|om-mig|privatlivspolitik|cookiepolitik)\.html$ /$1 [L,R=301,NC]
RewriteRule ^(kranio-sakral-terapi|priser-booking|om-mig|privatlivspolitik|cookiepolitik)\.php$ /$1 [L,R=301,NC]

# Clean URLs: /om-mig -> serve matching .php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Block direct access to config.php
<FilesMatch "^config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Block access to setup.php after initial setup (uncomment when done)
# <Files "api/setup.php">
#     Require all denied
# </Files>
